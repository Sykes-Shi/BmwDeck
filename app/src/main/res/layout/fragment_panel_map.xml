<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingTop="14dp"
        android:paddingRight="13dp"
        android:paddingBottom="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="百度地图汽车版"
            android:textColor="?attr/panelText"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/carMapStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="?attr/panelText"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="手机上照常使用百度地图手机版。两边可以分别选择目的地。"
            android:textColor="?attr/panelMuted"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="地图文字与控件"
            android:textColor="?attr/panelText"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/mapUiScaleGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <RadioButton android:id="@+id/mapUiScale100" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="原大小 · 100%" android:textColor="?attr/panelText" android:textSize="14sp" />
            <RadioButton android:id="@+id/mapUiScale125" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="放大 · 125%（默认）" android:textColor="?attr/panelText" android:textSize="14sp" />
            <RadioButton android:id="@+id/mapUiScale150" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="更大 · 150%" android:textColor="?attr/panelText" android:textSize="14sp" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="下次连接生效。调大中控地图的文字和按钮时，屏幕上能看到的地图范围会变小。"
            android:textColor="?attr/panelMuted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="分屏显示"
            android:textColor="?attr/panelText"
            android:textSize="16sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/baiduWideCruise"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="分屏地图适应宽屏"
            android:textColor="?attr/panelText"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="为搜索栏和红绿灯留出空间。分屏文字可能较小，展开地图后使用上方所选大小。下次连接生效。"
            android:textColor="?attr/panelMuted"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
