<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Center a compact tile beneath the 30–32dp icon; keep its original touch area. -->
    <item android:width="36dp" android:height="36dp" android:gravity="center">
        <shape android:shape="rectangle">
            <solid android:color="?attr/deckAccent" />
            <corners android:radius="9dp" />
        </shape>
    </item>
</layer-list>
